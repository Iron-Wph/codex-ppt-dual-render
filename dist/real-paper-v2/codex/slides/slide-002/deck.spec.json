  "spec_version": "0.4.0",
  "deck": {
    "id": "rlinf-robotwin-experiment-storyboard-revised",
    "title": "RLinf 在 RoboTwin 上：增益成立，但归因受实验契约约束",
    "purpose": "帮助具身智能与机器人学习研究者判断 RLinf 在 RoboTwin 上的性能与系统效率证据，并准确区分受控系统优势与纯算法因果结论。",
    "audience": "具身智能、机器人学习与强化学习研究者、论文评审者和实验复现者。",
    "language": "zh-CN",
    "aspect_ratio": "16:9",
    "communication_job": "By the end, embodied-AI researchers should be able to cite and reproduce RLinf’s RoboTwin result with the correct boundary because the experiments show a large cross-task SSR gain and competitive execution times under fixed seeds, evaluation protocol, and 8-card A800 conditions, while implementation differences prevent isolating a pure RLinf algorithm effect.",
    "talk_duration_minutes": 12,
    "audience_profile": {
      "role": "具身智能与机器人学习研究者、论文评审者、实验复现者",
      "prior_knowledge": "熟悉 VLA、SFT、GRPO、RoboTwin、SSR、OOD seed、多卡训练与基本实验对照方法。",
      "cares_about": [
        "RLinf 的性能增益是否跨任务成立",
        "SFT→RL 的比较是否公平",
        "reward、轨迹收集、精度和超参数差异是否改变结论",
        "seed、GPU、评估温度和训练步数是否可复现",
        "不同并行模式下 actor 与 rollout 的实际成本"
      ],
      "likely_questions": [
        "RLinf 的提升能否归因于 RL 信号本身？",
        "8 个任务上的增益是否一致，训练成本是多少？",
        "RLinf 与 SimpleVLA 的比较到底控制了哪些变量？",
        "评估温度、模型初始化和 GPU 是否会改变 SSR？",
        "实际运行时应该选择哪种并行模式？"
      ],
      "desired_outcome": "能够复现实验契约，引用跨任务性能与系统效率结果，并将结论表述为受控条件下的 RLinf 完整训练系统优势，而非无条件的纯算法优越性。"
    }
  },
