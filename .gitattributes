* text=auto
*.md text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.pptx binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary

