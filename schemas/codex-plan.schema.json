{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codex.local/schemas/codex-plan.schema.json",
  "title": "Local Codex Deck Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["deck", "narrative", "plan"],
  "properties": {
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "purpose", "audience", "language", "aspect_ratio"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 },
        "aspect_ratio": { "type": "string", "const": "16:9" }
      }
    },
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arc", "key_message"],
      "properties": {
        "arc": { "type": "string", "minLength": 1 },
        "key_message": { "type": "string", "minLength": 1 }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style_family": { "type": "string" },
        "image_policy": { "type": "string" },
        "density_profile": { "type": "string" },
        "style_reason": { "type": "string" },
        "style_context": { "type": "string" },
        "layout_system": { "type": "string" },
        "style_reference": { "type": "string" },
        "style_reference_html": { "type": "string" },
        "style_inspiration": { "type": "string" },
        "style_lock": { "type": "string" },
        "style_system": { "type": "object" }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "subtitle", "slides"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1 },
        "slides": {
          "type": "array",
          "minItems": 3,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "layout", "slide_goal", "primary_claim", "content"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "layout": { "type": "string", "enum": ["title", "pipeline", "comparison", "insight", "evidence"] },
              "role": { "type": "string", "minLength": 1 },
              "action_title": { "type": "string", "minLength": 1 },
              "slide_goal": { "type": "string", "minLength": 1 },
              "primary_claim": { "type": "string", "minLength": 1 },
              "evidence_refs": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1 } },
              "table_refs": { "type": "array", "maxItems": 4, "items": { "type": "string", "minLength": 1 } },
              "asset_candidates": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1 } },
              "visual_intent": { "type": "string", "enum": ["source_figure", "source_table", "data_chart", "method_diagram", "concept_illustration", "comparison_matrix", "text_led", "decorative_none"] },
              "speaker_note": { "type": "string" },
              "content": {
                "type": "object",
                "additionalProperties": false,
                "required": ["eyebrow", "title", "subtitle", "note", "kicker", "steps", "result", "columns", "takeaway"],
                "properties": {
                  "eyebrow": { "type": ["string", "null"] },
                  "title": { "type": "string", "minLength": 1 },
                  "subtitle": { "type": ["string", "null"] },
                  "note": {
                    "type": ["object", "null"],
                    "additionalProperties": false,
                    "required": ["label", "value"],
                    "properties": {
                      "label": { "type": "string", "minLength": 1 },
                      "value": { "type": "string", "minLength": 1 }
                    }
                  },
                  "kicker": { "type": ["string", "null"] },
                  "steps": {
                    "type": ["array", "null"],
                    "maxItems": 4,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["title", "text", "metric", "tone"],
                      "properties": {
                        "title": { "type": "string", "minLength": 1 },
                        "text": { "type": "string", "minLength": 1 },
                        "metric": { "type": "string", "minLength": 1 },
                        "tone": { "type": "string", "minLength": 1 }
                      }
                    }
                  },
                  "result": {
                    "type": ["object", "null"],
                    "additionalProperties": false,
                    "required": ["label", "value"],
                    "properties": {
                      "label": { "type": "string", "minLength": 1 },
                      "value": { "type": "string", "minLength": 1 }
                    }
                  },
                  "columns": {
                    "type": ["array", "null"],
                    "maxItems": 2,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["label", "headline", "points", "tone"],
                      "properties": {
                        "label": { "type": "string", "minLength": 1 },
                        "headline": { "type": "string", "minLength": 1 },
                        "points": {
                          "type": "array",
                          "maxItems": 4,
                          "items": { "type": "string", "minLength": 1 }
                        },
                        "tone": { "type": "string", "minLength": 1 }
                      }
                    }
                  },
                  "takeaway": {
                    "type": ["object", "null"],
                    "additionalProperties": false,
                    "required": ["label", "value"],
                    "properties": {
                      "label": { "type": "string", "minLength": 1 },
                      "value": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
