{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codex.local/schemas/codex-review.schema.json",
  "title": "Local Codex Deck Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "changes", "content_flags"],
  "properties": {
    "status": { "enum": ["pass", "revise", "blocked"] },
    "summary": { "type": "string", "minLength": 1 },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slide_id", "element_id", "issue_id", "action", "priority"],
        "properties": {
          "slide_id": { "type": "string", "minLength": 1 },
          "element_id": { "type": ["string", "null"] },
          "issue_id": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "priority": { "enum": ["high", "medium", "low"] }
        }
      }
    },
    "content_flags": { "type": "array", "items": { "type": "string" } }
  }
}
