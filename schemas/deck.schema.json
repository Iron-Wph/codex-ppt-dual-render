{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codex.local/schemas/deck.schema.json",
  "title": "Codex Dual Render Deck",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "deck", "theme", "narrative", "slides"],
  "properties": {
    "spec_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "purpose", "audience", "language", "aspect_ratio", "communication_job", "talk_duration_minutes", "audience_profile"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 },
        "aspect_ratio": { "type": "string", "const": "16:9" },
        "communication_job": { "type": "string", "minLength": 12 },
        "talk_duration_minutes": { "type": "integer", "minimum": 5, "maximum": 60 },
        "audience_profile": {
          "type": "object",
          "required": ["role", "prior_knowledge", "cares_about", "likely_questions", "desired_outcome"],
          "properties": {
            "role": { "type": "string" },
            "prior_knowledge": { "type": "string" },
            "cares_about": { "type": "array", "items": { "type": "string" } },
            "likely_questions": { "type": "array", "items": { "type": "string" } },
            "desired_outcome": { "type": "string" }
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "required": ["id", "fonts", "colors", "spacing", "typography"],
      "properties": {
        "id": { "type": "string" },
        "fonts": { "type": "object" },
        "colors": { "type": "object" },
        "spacing": { "type": "object" },
        "typography": { "type": "object" }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style_family": { "type": "string" },
        "image_policy": { "type": "string" },
        "density_profile": { "type": "string" },
        "style_reason": { "type": "string" },
        "style_context": { "type": "string" },
        "layout_system": { "type": "string" },
        "style_reference": { "type": "string" },
        "style_reference_html": { "type": "string" },
        "style_inspiration": { "type": "string" },
        "style_lock": { "type": "string" },
        "style_system": { "type": "object" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": { "type": "object" },
        "parser": { "type": "string" },
        "parser_details": { "type": ["object", "null"] },
        "page_count": { "type": "integer", "minimum": 0 },
        "character_count": { "type": "integer", "minimum": 0 },
        "sections": { "type": "array" },
        "claims": { "type": "array" },
        "diagnostics": { "type": ["object", "null"] }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "path", "editable_level"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "source_page": { "type": ["integer", "null"] },
          "mime_type": { "type": ["string", "null"] },
          "caption": { "type": "string" },
          "alt_text": { "type": "string" },
          "editable_level": { "type": "string" }
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "source_page", "values", "editable_level"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string" },
          "source_page": { "type": ["integer", "null"] },
          "rows": { "type": "integer", "minimum": 1 },
          "columns": { "type": "integer", "minimum": 1 },
          "values": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
          "bbox": { "type": ["array", "null"] },
          "caption": { "type": "string" },
          "editable_level": { "type": "string" }
        }
      }
    },
    "formulas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "source_page", "latex", "editable_level"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "const": "formula" },
          "source_page": { "type": ["integer", "null"] },
          "index": { "type": "integer", "minimum": 1 },
          "bbox": { "type": ["array", "null"] },
          "latex": { "type": "string" },
          "asset_ref": { "type": ["string", "null"] },
          "editable_level": { "type": "string" }
        }
      }
    },
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arc", "key_message", "opening_question", "closing_answer", "sections", "priority_map", "logic_check"],
      "properties": {
        "arc": { "type": "string", "minLength": 1 },
        "key_message": { "type": "string", "minLength": 1 },
        "opening_question": { "type": "string", "minLength": 1 },
        "closing_answer": { "type": "string", "minLength": 1 },
        "sections": { "type": "array" },
        "priority_map": { "type": "object" },
        "logic_check": { "type": "object" }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
          "required": ["id", "layout", "composition_id", "role", "content_priority", "action_title", "audience_question", "narrative_job", "slide_goal", "primary_claim", "evidence", "implication", "transition_in", "transition_out", "visual_plan", "speaker_notes", "content", "elements", "review_flags"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "layout": { "enum": ["title", "pipeline", "comparison", "insight", "evidence", "hero-image", "metric-stage", "story-split", "chart-focus", "matrix", "timeline", "evidence-collage"] },
          "composition_id": { "enum": ["thesis-stage", "image-thesis-split", "argument-pair", "mechanism-triptych", "causal-flow", "metric-triad", "chart-with-interpretation-rail", "evidence-table", "evidence-collage", "answer-and-boundary"] },
          "role": { "type": "string" },
          "content_priority": { "enum": ["core", "support", "context"] },
          "action_title": { "type": "string" },
          "audience_question": { "type": "string" },
          "narrative_job": { "type": "string" },
          "slide_goal": { "type": "string", "minLength": 1 },
          "primary_claim": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array" },
          "implication": { "type": "string" },
          "transition_in": { "type": "string" },
          "transition_out": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "table_refs": { "type": "array", "items": { "type": "string" } },
          "asset_candidates": { "type": "array", "items": { "type": "string" } },
          "visual_intent": { "type": "string" },
          "visual_plan": {
            "type": "object",
            "additionalProperties": false,
            "required": ["layout_family", "primary_visual", "image_budget", "image_roles", "data_strategy", "background_variant", "density"],
            "properties": {
              "layout_family": { "enum": ["title", "pipeline", "comparison", "insight", "evidence", "hero-image", "metric-stage", "story-split", "chart-focus", "matrix", "timeline", "evidence-collage"] },
              "primary_visual": { "type": ["string", "null"] },
              "image_budget": { "type": "integer", "minimum": 0, "maximum": 3 },
              "image_roles": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "enum": ["hero", "evidence", "comparison", "context"] } },
              "data_strategy": { "enum": ["none", "native_chart", "native_table", "diagram", "source_figure"] },
              "background_variant": { "enum": ["default", "light", "dark", "quiet", "immersive"] },
              "density": { "enum": ["sparse", "balanced", "dense"] }
            }
          },
          "speaker_note": { "type": "string" },
          "speaker_notes": {
            "type": "object",
            "required": ["talk_track", "delivery_cue", "source_refs", "estimated_seconds"],
            "properties": {
              "talk_track": { "type": "string", "minLength": 80 },
              "delivery_cue": { "type": "string" },
              "source_refs": { "type": "array", "items": { "type": "string" } },
              "estimated_seconds": { "type": "integer", "minimum": 20, "maximum": 240 }
            }
          },
          "content": { "type": "object" },
          "flow_model": { "type": ["string", "null"], "enum": ["linear", "branch", "feedback", null] },
          "reading_order_groups": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "mode", "items"],
              "properties": {
                "id": { "type": "string" },
                "mode": { "enum": ["sequence", "parallel", "feedback"] },
                "items": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "connector_legend": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["role", "label"],
              "properties": {
                "role": { "type": "string" },
                "label": { "type": "string" }
              }
            }
          },
          "reading_order": { "type": "array", "items": { "type": "string" } },
          "elements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "kind", "role", "editable", "render_mode"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "kind": { "enum": ["text", "shape", "image", "chart", "table", "connector", "code"] },
                "role": { "type": "string", "minLength": 1 },
                "text": { "type": "string" },
                "editable": { "type": "boolean" },
                "render_mode": { "enum": ["native", "asset", "html_only", "pptx_only"] },
                "data": { "type": "object" },
                "asset_ref": { "type": "string" },
                "source_page": { "type": ["integer", "null"] },
                "alt_text": { "type": "string" },
                "box": {
                  "type": "object",
                  "required": ["left", "top", "width", "height"],
                  "properties": {
                    "left": { "type": "number" },
                    "top": { "type": "number" },
                    "width": { "type": "number", "exclusiveMinimum": 0 },
                    "height": { "type": "number", "exclusiveMinimum": 0 }
                  }
                }
              }
            }
          },
          "review_flags": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rule_id", "severity", "message"],
              "properties": {
                "rule_id": { "type": "string" },
                "severity": { "enum": ["info", "warning", "error"] },
                "message": { "type": "string" },
                "element_id": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
